一、前期准备
首先登录淘宝开放平台完成开发者认证，创建应用并获取App Key、App Secret，开通商品搜索、商品详情查询权限。相较于逆向爬虫，官方API合规性强、稳定性高，无封禁IP风险，是企业级数据采集首选方案。核心用到两个接口：列表搜索接口获取批量商品ID，详情接口解析商品价格、标题、销量等数据。

二、实战核心代码
以下代码实现分页抓取淘宝商品列表，批量调取详情数据，内置官方标准签名算法、异常捕获，适配Python3环境。

import requests, time, hashlib

APP_KEY = "你的Key"
APP_SECRET = "你的Secret"
URL = "https://gw.api.taobao.com/router/rest"

# 生成官方签名
def get_sign(params):
    sorted_p = sorted(params.items())
    sign_str = "".join(f"{k}{v}" for k,v in sorted_p) + APP_SECRET
    return hashlib.md5(sign_str.encode()).hexdigest().upper()

# 抓取商品列表
def get_list(keyword, page=1):
    params = {"app_key":APP_KEY,"method":"taobao.item.search","timestamp":str(int(time.time())),
              "format":"json","v":"2.0","q":keyword,"page_no":page,"page_size":20}
    params["sign"] = get_sign(params)
    return requests.get(URL, params=params).json()

# 抓取商品详情
def get_detail(num_iid):
    params = {"app_key":APP_KEY,"method":"taobao.item.get","timestamp":str(int(time.time())),
              "format":"json","v":"2.0","num_iid":num_iid}
    params["sign"] = get_sign(params)
    return requests.get(URL, params=params).json()

# 批量采集主流程
if __name__ == "__main__":
    list_data = get_list("连衣裙", 1)
    if "items" in list_data:
        for item in list_data["items"]["item"]:
            detail = get_detail(item["num_iid"])
            print("商品标题：", detail["item"]["title"])
            print("商品价格：", detail["item"]["price"])
            time.sleep(0.3) # 防限流
